# ===== ローカル開発環境設定テンプレート =====
# このファイルを参考に .env.local を作成してください（ローカルホスト接続用）
# .env.local は Git 除外対象です

# Docker なしでローカル開発する場合の設定
POSTGRES_DB=todoapp
POSTGRES_USER=todouser
POSTGRES_PASSWORD=todopass

# ローカルホスト上の PostgreSQL に接続
DATABASE_URL=postgresql://todouser:todopass@localhost:5432/todoapp
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=todouser
DATABASE_PASSWORD=todopass
DATABASE_NAME=todoapp

# 開発環境設定
NODE_ENV=development
PORT=3000

# 本番環境での Docker 接続設定例（参考）
# Docker Compose で起動した場合、以下のように変更
# DATABASE_HOST=postgres
# DATABASE_URL=postgresql://todouser:todopass@postgres:5432/todoapp
