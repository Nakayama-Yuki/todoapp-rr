{
  "name": "my-react-router-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "docker:dev": "docker-compose -f docker-compose.dev.yml --env-file .env up -d",
    "docker:prod": "docker-compose -f docker-compose.prod.yml --env-file .env up -d --build",
    "dev:down": "docker-compose -f docker-compose.dev.yml down",
    "prod:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "prod:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "docker:ps": "docker-compose -f docker-compose.dev.yml ps",
    "prod:ps": "docker-compose -f docker-compose.prod.yml ps",
    "postgres:up": "docker-compose -f docker-compose.dev.yml --env-file .env up -d postgres",
    "postgres:logs": "docker-compose -f docker-compose.dev.yml logs postgres"
  },
  "dependencies": {
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "dotenv": "^17.4.2",
    "isbot": "^5.2.2",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  }
}
